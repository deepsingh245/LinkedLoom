rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // User profile: owner only.
    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;

      // OAuth tokens (LinkedIn/Reddit) are written and read by Cloud Functions
      // only (Admin SDK bypasses rules). Never expose them to clients.
      match /connections/{provider} {
        allow read, write: if false;
      }
      match /redditPosts/{id} {
        allow read, write: if false;
      }
    }

    // Posts: owner only.
    match /posts/{postId} {
      allow create: if request.auth != null && request.resource.data.user_id == request.auth.uid;
      allow read, update, delete: if request.auth != null && resource.data.user_id == request.auth.uid;
    }

    // Everything else (oauthStates, analytics, ...) is backend-only.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
