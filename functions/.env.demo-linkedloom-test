# Loaded only by the emulator when running with --project demo-linkedloom-test (e2e tests).
# No real AI calls: providers are replaced by the deterministic mock (functions/src/ai-core/providers/mock.ts).
AI_PROVIDER_MOCK=true
EDITOR_TEXT_DAILY_CAP=3
AUTOPILOT_TRIAL_CREDITS=200
# Let the research fetcher reach the local fixture server (honoured only inside the emulator).
RESEARCH_ALLOW_LOCALHOST=true
AUTOPILOT_DAILY_RUNS=6
# Durable workflows: Cloud Tasks retries a failed step after this many seconds (production default 15).
RESEARCH_RETRY_MIN_BACKOFF=1
# LinkedIn sign-in tests: a fake LinkedIn (token + userinfo) runs on this port during the tests (emulator only).
LINKEDIN_CLIENT_ID=test-client
LINKEDIN_CLIENT_SECRET=test-secret
LINKEDIN_REDIRECT_URI=http://localhost:3000/linkedin/callback
LINKEDIN_OAUTH_BASE=http://127.0.0.1:47891
LINKEDIN_API_BASE=http://127.0.0.1:47891
